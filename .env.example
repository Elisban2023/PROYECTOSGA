# local | production
DJANGO_ENV=local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
DJANGO_TIME_ZONE=America/Lima

DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your_database_host
DB_PORT=3306
DB_CONNECT_TIMEOUT=10

# Production only
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

SENDGRID_ENABLED=False
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=SGA Institucion Educativa CUSCO
SENDGRID_TIMEOUT=15
FRONTEND_URL=http://localhost:5173
MFA_CODE_TTL_MINUTES=10
MFA_MAX_ATTEMPTS=5
PASSWORD_RESET_TIMEOUT=1800
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_FRONTEND_PATH=/recuperar-contrasena/confirmar

# Keep both disabled in production unless access is additionally restricted.
DJANGO_ADMIN_ENABLED=False
API_DOCS_ENABLED=False

OPENAI_ENABLED=True
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_TIMEOUT=45
OPENAI_MAX_OUTPUT_TOKENS=1200
